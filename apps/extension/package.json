  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@wxt-dev/module-react": "^1.1.3",
    "vitest": "^3.2.7",
    "wxt": "^0.20.11"
  }
